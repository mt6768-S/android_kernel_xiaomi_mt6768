# selene ailesi icin evrensel ekler - device.config uzerine uygulanir
# eos: NFC dugumu compatible="nq-nci" -> pn553-19a.c ile eslesir
CONFIG_NFC_PN553_19A_DEVICES=y
# selene primary charger (bq25890 at 0x6a): BC1.2 and USB VBUS
CONFIG_CHARGER_BQ25890=y

# GECICI teshis: recovery reboot yerine panic (acilis cozulunce KALDIR)
CONFIG_PANIC_ON_RECOVERY_REBOOT=y
