CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/fire"
CONFIG_TARGET_PRODUCT_FIRE=y
CONFIG_ARCH_MTK_PROJECT="fire"
CONFIG_LCM_HEIGHT="2460"
CONFIG_MTK_MT6382_BDG=y
CONFIG_MTK_MT6382_VDO_MODE=y
CONFIG_TCPC_WUSB3801=y
CONFIG_TCPC_RT1711H=y
CONFIG_CUSTOM_KERNEL_LCM="dsi_panel_m19a_36_02_0a_dsc_vdo dsi_panel_m19a_42_03_0b_dsc_vdo dsi_panel_m19a_42_03_0c_dsc_vdo dsi_panel_m19a_42_03_0d_dsc_vdo"
# CONFIG_TOUCHSCREEN_NT36xxx_SPI is not set
CONFIG_TOUCHSCREEN_MTK_NT36672C_SPI=y
CONFIG_TOUCHSCREEN_FTS_FT8720=y
CONFIG_CHARGER_SYV690=y
CONFIG_TCPC_HUSB320=y
